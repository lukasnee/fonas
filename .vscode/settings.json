{
    "C_Cpp.autoAddFileAssociations": false,
    // We use clangd instead of Microsoft C/C++ Extension for IntelliSense
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.formatting": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    // We embrace CMake Presets
    "cmake.useCMakePresets": "always",
    // This is so clangd operates on last configured build, no matter if build
    // directory changes. The --compile-commands-dir in clangd.arguments must be
    // set to the same dir.
    "cmake.copyCompileCommands": "${workspaceFolder}/build/compile_commands.json",
    // We use matepek.vscode-catch2-test-adapter instead
    "cmake.ctest.testExplorerIntegrationEnabled": false,
    "clangd.enable": true,
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--query-driver=**", // clangd becomes aware of arm-none-eabi-gcc and its standard includes
        "--background-index",
        "--clang-tidy",
        "--completion-style=detailed"
    ],
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format",
        "editor.formatOnSave": true
    },
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format",
        "editor.formatOnSave": true
    },
    "psi-header.templates": [
        {
            "language": "c",
            "template": [
                "Copyright (c) <<year>> <<author>> <<<authoremail>>>",
                "SPDX-License-Identifier: GPL-2.0-only",
            ]
        },
        {
            "language": "cpp",
            "template": [
                "Copyright (c) <<year>> <<author>> <<<authoremail>>>",
                "SPDX-License-Identifier: GPL-2.0-only"
            ]
        },
        {
            "language": "python",
            "template": [
                "Copyright (c) <<year>> <<author>> <<<authoremail>>>",
                "SPDX-License-Identifier: GPL-2.0-only"
            ]
        },
    ],
    "psi-header.lang-config": [
        {
            "language": "c",
            "begin": "",
            "prefix": "// ",
            "end": "",
            "blankLinesAfter": 1
        },
        {
            "language": "cpp",
            "begin": "",
            "prefix": "// ",
            "end": "",
            "blankLinesAfter": 1
        },
        {
            "language": "python",
            "begin": "",
            "prefix": "# ",
            "end": "",
            "blankLinesAfter": 1
        },
    ],
    "psi-header.changes-tracking": {
        "autoHeader": "autoSave",
        "include": [
            "c",
            "cpp",
            "python"
        ],
    },
}
